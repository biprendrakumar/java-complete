import java.util.Scanner;
public class rock_paper_scissors {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String M=sc.next();
        switch (M) {
            case "rock":
                System.out.println("paper");
                break;
            case "paper":
                System.out.println("scissors");
                break;
            case "scissors":
                System.out.println("rock");
            default:
                break;
        }sc.close();
    }
}
