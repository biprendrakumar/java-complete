import java.util.*;

public class multi3 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int N = sc.nextInt();
        int A[] = new int[N];
        int i;
        int ans = 0;
        for (i = 0; i < N; i++) {
            A[i] = sc.nextInt();

        }
        for (i = 0; i < N; i++) {
            if (A[i] % 3 == 0) {
                ans++;
            }
        }
        System.out.println(ans);
        sc.close();
    }
}
