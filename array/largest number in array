package array;
import java.util.*;

public class largestnumber {
    Scanner sc = new Scanner(System.in);
    int arr[] = new int[5];
    int i = 0;
    int largest = 0;
    public void findlargest() {
        for (i = 0; i <= 4; i++) {
            arr[i] = sc.nextInt();
        }

        for (i = 0; i <= 4; i++) {
            if (arr[i] > largest) {
                largest = arr[i];
            }
        }

        System.out.println(largest);
        sc.close();
    }
    
}
